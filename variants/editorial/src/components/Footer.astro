---
// Footer content verbatim from the live site (footer widgets + socials).
// EDITORIAL MINIMAL: colophon-style footer — hairline top rule, small-caps
// column headings, quiet text links (socials as text, journal colophon
// convention), centered imprint line.
const socials = [
  { label: 'X (Twitter)', href: 'https://x.com/FoodHackskw' },
  { label: 'Instagram', href: 'https://www.instagram.com/foodhacksco' },
  { label: 'Facebook', href: 'https://www.facebook.com/Foodhackskwt/' },
  { label: 'Snapchat', href: 'https://snapchat.com/t/nXtO2N8V' },
];
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-hairline bg-oat">
  <div class="mx-auto grid max-w-[1240px] gap-12 px-5 pb-14 pt-16 md:grid-cols-12 md:px-8">
    <div class="md:col-span-4">
      <h3 class="kicker !font-head2">About Food Hacks</h3>
      <hr class="rule-green mt-3 w-10" />
      <p class="mt-5 max-w-[38ch] text-[14px] leading-[24px] text-stone">
        Food Hacks offers innovative non-stick cooking sprays that combine quality and versatility
        to make every meal more delicious and easy.
      </p>
    </div>

    <div class="md:col-span-3">
      <h3 class="kicker !font-head2">Subscribe To Our Newsletter</h3>
      <hr class="rule-green mt-3 w-10" />
      <p class="mt-5 max-w-[32ch] text-[14px] leading-[24px] text-stone">
        Join our newsletter to stay up to date on features and releases.
      </p>
    </div>

    <div class="md:col-span-2">
      <h3 class="kicker !font-head2">Follow us on</h3>
      <hr class="rule-green mt-3 w-10" />
      <ul class="mt-5 space-y-2">
        {socials.map((s) => (
          <li>
            <a
              href={s.href}
              target="_blank"
              rel="noopener"
              class="link-ink text-[14px] leading-[24px]"
            >
              {s.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="md:col-span-3">
      <h3 class="kicker !font-head2">Get in touch</h3>
      <hr class="rule-green mt-3 w-10" />
      <ul class="mt-5 space-y-2">
        <li>
          <a href="tel:+96522204332" class="link-ink text-[14px] leading-[24px]">+965 22204332</a>
        </li>
        <li>
          <a href="mailto:info@foodhacks.co" class="link-ink text-[14px] leading-[24px]">info@foodhacks.co</a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-hairline">
    <div class="mx-auto flex max-w-[1240px] items-center justify-between gap-4 px-5 py-6 md:px-8">
      <p class="text-[12.5px] tracking-[0.06em] text-stone">
        &copy; {year} <a href="/" title="Food Hacks" rel="home" class="link-ink">Food Hacks</a>. All rights reserved.
      </p>
      <p class="kicker hidden sm:block" aria-hidden="true">Kuwait &mdash; 100% Natural</p>
    </div>
  </div>
</footer>
