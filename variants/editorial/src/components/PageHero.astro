---
// EDITORIAL MINIMAL chapter opener — replaces the green banner with a quiet
// magazine chapter head: small-caps kicker ("Chapter 02 — The Sprays"),
// huge serif h1, italic serif deck, oversized brand-green folio numeral,
// hairline rules top and bottom.
interface Props {
  title: string;
  subtitle?: string;
  /** Chapter numeral, e.g. "02" (omit for appendix-style pages) */
  chapter?: string;
  /** Chapter name for the kicker, e.g. "The Sprays" */
  chapterName?: string;
}
const { title, subtitle, chapter, chapterName } = Astro.props;
---

<section class="border-b border-hairline">
  <div class="mx-auto max-w-[1240px] px-5 pb-14 pt-16 md:px-8 md:pb-20 md:pt-24">
    <div class="grid items-end gap-8 md:grid-cols-12">
      <div class="md:col-span-9">
        {(chapter || chapterName) && (
          <p class="kicker">
            {chapter && <span class="num">{chapter}</span>}
            {chapter && chapterName && <span aria-hidden="true"> &mdash; </span>}
            {chapterName}
          </p>
        )}
        <h1 class="mt-5 text-[clamp(2.6rem,7vw,5.25rem)]">{title}</h1>
        {subtitle && (
          <p class="mt-6 font-serif text-[clamp(1.05rem,2vw,1.35rem)] italic text-stone">
            {subtitle}
          </p>
        )}
        <slot />
      </div>
      {chapter && (
        <div class="hidden justify-end md:col-span-3 md:flex" aria-hidden="true">
          <span class="folio-num text-[clamp(5rem,10vw,8.5rem)]">{chapter}</span>
        </div>
      )}
    </div>
  </div>
</section>
