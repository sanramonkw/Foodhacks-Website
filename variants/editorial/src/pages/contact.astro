---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const contactPage = {
  '@type': 'ContactPage',
  '@id': 'https://foodhacks.co/contact/',
  url: 'https://foodhacks.co/contact/',
  name: 'Contact Us - Food Hacks',
  about: { '@id': 'https://foodhacks.co/#organization' },
};
---

<BaseLayout title="Contact Us - Food Hacks" schema={[contactPage]}>
  <PageHero title="Contact Us" subtitle="Get in Touch" chapter="04" chapterName="Get in Touch" />

  <section class="mx-auto max-w-[1240px] px-5 py-16 md:px-8 md:py-24">
    <div class="grid gap-14 md:grid-cols-12 md:gap-8">
      <!-- correspondence details, colophon register -->
      <div class="md:col-span-4">
        <h5 class="kicker !font-head2">Telephone</h5>
        <p class="mt-3">
          <a href="tel:+96522204332" class="link-ink font-serif text-[1.3rem] font-[420]">+965 22204332</a>
        </p>
        <hr class="rule my-8" />
        <h5 class="kicker !font-head2">Email</h5>
        <p class="mt-3">
          <a href="mailto:info@foodhacks.co" class="link-ink font-serif text-[1.3rem] font-[420]">info@foodhacks.co</a>
        </p>
      </div>

      <!-- the form, set on a hairline-framed plate -->
      <div class="md:col-span-7 md:col-start-6">
        <div class="border border-hairline bg-oat/60 px-7 py-9 md:px-12 md:py-12">
          <h4 class="max-w-[26ch] font-serif text-[clamp(1.25rem,2.2vw,1.6rem)] font-[440] leading-[1.35]">
            For general inquiries, please fill out the form below:
          </h4>
          <hr class="rule-green mt-6 w-12" />
          <!--
            TODO: the WP site used Contact Form 7 + reCAPTCHA v3. This static form
            needs a backend: wire `action` to a form service (Formspree/Basin) or a
            serverless endpoint before launch.
          -->
          <form method="post" action="#" class="mt-8 space-y-5">
            <div>
              <label for="cf-name" class="kicker">Name</label>
              <input id="cf-name" type="text" name="your-name" required maxlength="400" class="field-line mt-1" autocomplete="name" />
            </div>
            <div>
              <label for="cf-email" class="kicker">Email</label>
              <input id="cf-email" type="email" name="your-email" required maxlength="400" class="field-line mt-1" autocomplete="email" />
            </div>
            <div>
              <label for="cf-phone" class="kicker">Phone</label>
              <input id="cf-phone" type="tel" name="your-phone" required maxlength="400" class="field-line mt-1" autocomplete="tel" />
            </div>
            <div>
              <label for="cf-message" class="kicker">Message</label>
              <textarea id="cf-message" name="your-message" rows="6" maxlength="2000" class="field-line mt-1"></textarea>
            </div>
            <button type="submit" class="btn-ink !mt-9">Submit</button>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
