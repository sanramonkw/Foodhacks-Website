---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';

const products = (await getCollection('products')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout title="Home - Food Hacks">
  <!-- COVER — quiet masthead headline over the banner photograph, framed
       with breathing room like a journal cover plate -->
  <section class="mx-auto max-w-[1240px] px-5 pt-14 md:px-8 md:pt-20">
    <p class="kicker text-center">Kuwait &mdash; 100% Natural Cooking Sprays</p>
    <h1 class="mt-6 text-center text-[clamp(3.25rem,11vw,8.5rem)]">Food&nbsp;Hacks</h1>

    <figure class="mt-10 md:mt-14">
      <img
        src="/images/Banner_20Home_20Page.png"
        alt="Food Hacks — innovative non-stick cooking sprays"
        width="1920"
        height="700"
        loading="eager"
        fetchpriority="high"
        class="aspect-[16/9] w-full border border-hairline object-cover md:aspect-[21/9]"
      />
    </figure>
  </section>

  <!-- 01 THE IDEA — brand intro, copy verbatim from the live homepage -->
  <section class="mx-auto max-w-[1240px] px-5 py-20 md:px-8 md:py-28">
    <div class="flex items-baseline gap-6 border-t border-ink pt-4">
      <span class="folio-num text-[clamp(2.5rem,5vw,4rem)]" aria-hidden="true">01</span>
      <p class="kicker">The Idea</p>
    </div>

    <div class="mt-12 grid gap-12 md:mt-16 md:grid-cols-12 md:gap-8">
      <div class="md:col-span-6 lg:col-span-5">
        <h2 class="text-[clamp(2rem,4.5vw,3.25rem)]">Food Hacks</h2>
        <p class="mt-7 max-w-[58ch]">
          Food Hacks offers innovative non-stick cooking sprays that combine quality and
          versatility to make every meal more delicious and easy. Enjoy a variety of products
          including our Extra Virgin Olive Oil Spray, our Premium Truffle Olive Oil Spray, and our
          Premium Saffron Spray. Each product is made with 100% natural ingredients, helping you
          prepare healthy, delicious meals using less fat. Make your cooking experience even more
          special with Food Hacks!
        </p>
        <p class="mt-9">
          <a href="/about/" class="link-action">read more <span class="arrow" aria-hidden="true">&#8594;</span></a>
        </p>
      </div>

      <div class="md:col-span-6 md:col-start-7 lg:col-span-6 lg:col-start-7">
        <figure>
          <div class="bg-oat px-10 py-14">
            <img
              src="/images/products.png"
              alt="Food Hacks cooking spray range"
              width="900"
              height="1440"
              loading="lazy"
              class="mx-auto max-h-[460px] w-auto mix-blend-multiply"
            />
          </div>
          <figcaption class="kicker mt-4 text-right">The range &mdash; three sprays</figcaption>
        </figure>
      </div>
    </div>

    <!-- Our Vision — set as an editorial pull-quote spread (copy verbatim,
         including the source's garbled sentence — see master CLAUDE.md) -->
    <div class="mt-20 grid gap-8 border-t border-hairline pt-14 md:mt-28 md:grid-cols-12">
      <div class="md:col-span-3">
        <h2 class="font-serif text-[clamp(1.6rem,3vw,2.25rem)] italic">Our Vision</h2>
        <hr class="rule-green mt-5 w-12" />
      </div>
      <div class="md:col-span-8 md:col-start-5">
        <p class="font-serif text-[clamp(1.1rem,2vw,1.4rem)] font-[380] leading-[1.65]">
          To be a leader in providing healthy and easy cooking solutions, maki achieving maximum
          health bene ng healthy food accessible and easy for everyone without any hassle. We are
          committed to developing innovative products and technologies that contribute to promoting
          healthy lifestyles, with a focus on using natural ingredients and cooking practices that
          ensure preserving nutritional values and good taste. Our goal is to enable our customers
          to enjoy delicious and healthy food with minimal effort, while fits.
        </p>
      </div>
    </div>
  </section>

  <!-- 02 THE SPRAYS — the tasting feature -->
  <section class="mx-auto max-w-[1240px] px-5 pb-24 md:px-8 md:pb-32">
    <div class="flex items-baseline gap-6 border-t border-ink pt-4">
      <span class="folio-num text-[clamp(2.5rem,5vw,4rem)]" aria-hidden="true">02</span>
      <p class="kicker">The Sprays</p>
    </div>

    <div class="mt-12 flex flex-wrap items-end justify-between gap-6 md:mt-16">
      <h2 class="text-[clamp(2rem,4.5vw,3.25rem)]">Our Products</h2>
      <a href="/products/" class="link-action">Shop All <span class="arrow" aria-hidden="true">&#8594;</span></a>
    </div>

    <div class="mt-14 grid gap-x-8 gap-y-16 sm:grid-cols-2 lg:grid-cols-3">
      {products.map((product, i) => (
        <div class:list={[i === 1 && 'lg:mt-16', i === 2 && 'lg:mt-32']}>
          <ProductCard product={product} />
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
