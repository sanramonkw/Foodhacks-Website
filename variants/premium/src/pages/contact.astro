---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const contactPage = {
  '@type': 'ContactPage',
  '@id': 'https://foodhacks.co/contact/',
  url: 'https://foodhacks.co/contact/',
  name: 'Contact Us - Food Hacks',
  about: { '@id': 'https://foodhacks.co/#organization' },
};
---

<BaseLayout title="Contact Us - Food Hacks" schema={[contactPage]}>
  <PageHero title="Contact Us" subtitle="Get in Touch" />

  <section class="mx-auto max-w-[1180px] px-6 py-20">
    <div class="grid items-start gap-10 md:grid-cols-[5fr_7fr]">
      <!-- direct lines — a small navy salon card -->
      <div class="reveal atmosphere overflow-hidden rounded-card p-8 text-cream md:sticky md:top-28 md:p-10">
        <div class="hairline-left"></div>
        <p class="mt-8">
          <a href="tel:+96522204332" class="group inline-flex items-center gap-4 text-[17px] text-cream transition-colors hover:text-brand-hover">
            <span class="inline-flex h-[42px] w-[42px] shrink-0 items-center justify-center rounded-full bg-brand text-ink-deep transition-colors group-hover:bg-brand-hover">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.85 21 3 13.15 3 3.5a1 1 0 0 1 1-1H7.5a1 1 0 0 1 1 1c0 1.24.2 2.45.57 3.57a1 1 0 0 1-.24 1.02l-2.21 2.2Z"/></svg>
            </span>
            +965 22204332
          </a>
        </p>
        <div class="my-7 h-px bg-white/15"></div>
        <p>
          <a href="mailto:info@foodhacks.co" class="group inline-flex items-center gap-4 text-[17px] text-cream transition-colors hover:text-brand-hover">
            <span class="inline-flex h-[42px] w-[42px] shrink-0 items-center justify-center rounded-full bg-brand text-ink-deep transition-colors group-hover:bg-brand-hover">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6L22 7"/></svg>
            </span>
            info@foodhacks.co
          </a>
        </p>
      </div>

      <!-- inquiry form — ivory plinth card, refined underline fields -->
      <div class="reveal plinth-card p-8 md:p-10" style="--reveal-delay: 0.1s">
        <h4 class="font-display text-[24px] font-[460] leading-snug !text-ink">
          For general inquiries, please fill out the form below:
        </h4>
        <div class="hairline-left mt-5"></div>
        <!--
          TODO: the WP site used Contact Form 7 + reCAPTCHA v3. This static form
          needs a backend: wire `action` to a form service (Formspree/Basin) or a
          serverless endpoint before launch.
        -->
        <form method="post" action="#" class="mt-8 space-y-4">
          <label class="sr-only" for="cf-name">Name</label>
          <input id="cf-name" type="text" name="your-name" placeholder="Name" required maxlength="400" class="field-line" />
          <label class="sr-only" for="cf-email">Email</label>
          <input id="cf-email" type="email" name="your-email" placeholder="Email" required maxlength="400" class="field-line" />
          <label class="sr-only" for="cf-phone">Phone</label>
          <input id="cf-phone" type="tel" name="your-phone" placeholder="Phone" required maxlength="400" class="field-line" />
          <label class="sr-only" for="cf-message">Message</label>
          <textarea id="cf-message" name="your-message" placeholder="Message" rows="6" maxlength="2000" class="field-line"></textarea>
          <button type="submit" class="btn-lux w-full !py-[18px] !text-[17px]">Submit</button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
