---
import { withBase } from '../utils/paths';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** Absolute-path OG image, defaults to home banner */
  ogImage?: string;
  ogType?: string;
  /** Extra JSON-LD graph nodes (Product, FAQPage, ...) */
  schema?: Record<string, unknown>[];
}

const {
  title,
  description = 'Food Hacks offers innovative non-stick cooking sprays that combine quality and versatility to make every meal more delicious and easy.',
  ogImage = '/images/Banner_20Home_20Page.png',
  ogType = 'website',
  schema = [],
} = Astro.props;

const site = Astro.site ?? new URL('https://foodhacks.co');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImageAbs = new URL(ogImage, site).href;

const organization = {
  '@type': 'Organization',
  '@id': `${site.href}#organization`,
  name: 'Food Hacks',
  url: site.href,
  logo: {
    '@type': 'ImageObject',
    url: new URL('/images/logo.png', site).href,
  },
  sameAs: [
    'https://x.com/FoodHackskw',
    'https://www.instagram.com/foodhacksco',
    'https://www.facebook.com/Foodhackskwt/',
    'https://snapchat.com/t/nXtO2N8V',
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+965-22204332',
    email: 'info@foodhacks.co',
    contactType: 'customer service',
  },
  parentOrganization: { '@type': 'Organization', name: 'San Ramon' },
};

const website = {
  '@type': 'WebSite',
  '@id': `${site.href}#website`,
  url: site.href,
  name: 'Food Hacks',
  publisher: { '@id': `${site.href}#organization` },
  inLanguage: 'en-US',
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [organization, website, ...schema],
};

const orderUrl = 'https://srkw.co/en/product-category/food-hacks/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={withBase('/favicon.png')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />

    <!-- Open Graph -->
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Food Hacks" />
    <meta property="og:image" content={ogImageAbs} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- flag JS availability so scroll-reveal styles only apply when they can be undone -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="min-h-screen bg-white text-black antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-5 focus:py-3 focus:text-white"
    >
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <!-- bold sticky Order Now CTA (external shop, as on the live nav) -->
    <a
      href={orderUrl}
      target="_blank"
      rel="noopener"
      class="btn-cta fixed bottom-5 right-5 z-50 !px-6 !py-3.5 !text-[13px] print:hidden"
      aria-label="Order Now on the srkw.co shop (opens in a new tab)"
    >
      <span aria-hidden="true" class="inline-block h-2 w-2 rounded-full bg-ink"></span>
      Order Now
    </a>

    <!-- kinetic scroll reveals + animated counters.
         Tiny inline module: IntersectionObserver only, transform/opacity only,
         fully skipped under prefers-reduced-motion (content stays visible). -->
    <script is:inline>
      (function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var reveals = document.querySelectorAll('.reveal');
        var counters = document.querySelectorAll('[data-count]');

        function finishCounter(el) {
          el.textContent = el.getAttribute('data-count');
        }

        if (reduce || !('IntersectionObserver' in window)) {
          reveals.forEach(function (el) { el.classList.add('is-in'); });
          counters.forEach(finishCounter);
          return;
        }

        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              var el = entry.target;
              el.classList.add('is-in');
              if (el.hasAttribute('data-count')) animateCount(el);
              io.unobserve(el);
            });
          },
          { threshold: 0.12, rootMargin: '12% 0px 0px 0px' }
        );

        function animateCount(el) {
          var target = parseInt(el.getAttribute('data-count'), 10);
          if (isNaN(target)) return finishCounter(el);
          var start = null;
          var dur = 1200;
          function step(ts) {
            if (start === null) start = ts;
            var p = Math.min((ts - start) / dur, 1);
            var eased = 1 - Math.pow(1 - p, 3);
            el.textContent = String(Math.round(target * eased));
            if (p < 1) requestAnimationFrame(step);
          }
          requestAnimationFrame(step);
        }

        reveals.forEach(function (el) { io.observe(el); });
        counters.forEach(function (el) {
          if (!el.classList.contains('reveal')) io.observe(el);
        });
      })();
    </script>
  </body>
</html>
