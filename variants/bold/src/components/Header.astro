---
import { withBase } from '../utils/paths';
// Real nav from the live site (menu-main-menu-en). "Order Now" is the
// external shop link; the live nav also carries an "العربية" language-switcher
// item — omitted until the Arabic mirror is migrated (see CLAUDE.md).
// BOLD variant: fixed navy bar, logo on a white "sticker" chip (the logo art
// is green + black, so it needs a light surface), Order Now as a solid CTA.
const nav = [
  { label: 'Home', href: '/' },
  { label: 'About us', href: '/about/' },
  { label: 'Our Products', href: '/products/' },
  { label: 'Contact Us', href: '/contact/' },
  { label: 'Return & Refund Policy', href: '/return-refund-policy/' },
  { label: 'FAQs', href: '/faqs/' },
];
const orderUrl = 'https://srkw.co/en/product-category/food-hacks/';
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="on-dark fixed inset-x-0 top-0 z-50 border-b-2 border-brand/60 bg-ink-deep/95 backdrop-blur-sm">
  <div class="mx-auto flex max-w-[1240px] items-center justify-between gap-4 px-4 py-2.5">
    <a href={withBase('/')} title="Food Hacks" rel="home" class="shrink-0 rounded-2xl bg-white px-3 py-1.5 shadow-[0_4px_0_rgba(141,191,68,0.6)]">
      <img src={withBase('/images/logo.png')} alt="Food Hacks" class="h-auto w-[108px]" width="640" height="300" />
    </a>

    <nav class="hidden items-center gap-6 xl:gap-7 lg:flex" aria-label="Main">
      {nav.map((item) => (
        <a
          href={withBase(item.href)}
          class:list={['nav-link', isActive(item.href) && 'nav-link-current']}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
      <a href={orderUrl} target="_blank" rel="noopener" class="btn-cta !px-6 !py-3 !text-[13px]">
        Order Now
      </a>
    </nav>

    <!-- mobile nav -->
    <details class="relative lg:hidden">
      <summary
        class="flex cursor-pointer list-none items-center gap-2 rounded-full border-2 border-brand px-4 py-2 font-head text-[13px] uppercase tracking-wider text-white"
        aria-label="Open menu"
      >
        Menu
      </summary>
      <nav class="absolute right-0 mt-3 w-72 rounded-3xl border-2 border-brand bg-ink-deep p-5 shadow-[0_24px_48px_-12px_rgba(0,0,0,0.6)]" aria-label="Mobile">
        <ul class="space-y-4">
          {nav.map((item) => (
            <li>
              <a
                href={withBase(item.href)}
                class:list={[
                  'block font-head2 text-[15px]',
                  isActive(item.href) ? 'text-brand' : 'text-white',
                ]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
          <li class="pt-1">
            <a href={orderUrl} target="_blank" rel="noopener" class="btn-cta w-full !py-3 !text-[13px]">
              Order Now
            </a>
          </li>
        </ul>
      </nav>
    </details>
  </div>
</header>
