---
import type { CollectionEntry } from 'astro:content';

interface Props {
  product: CollectionEntry<'products'>;
  /** Link the card to the product detail page (true) or the external shop (false) */
  linkToDetail?: boolean;
  /** Optional sticker tilt in degrees for the size badge (bento energy) */
  tilt?: number;
}
const { product, linkToDetail = true, tilt = -3 } = Astro.props;
const href = linkToDetail ? `/product/${product.id}/` : product.data.orderUrl;
---

<!-- BOLD variant bento product tile: navy panel with green border-glow, the
     studio render as a rounded "polaroid", size sticker, arrow chip. -->
<a
  href={href}
  target={linkToDetail ? undefined : '_blank'}
  rel={linkToDetail ? undefined : 'noopener'}
  class="tile tile-hover on-dark group relative block overflow-hidden border-2 border-brand/50 bg-ink p-3 hover:border-brand"
>
  <span
    class="sticker-solid absolute left-6 top-6 z-10 !text-[11px]"
    style={`transform: rotate(${tilt}deg);`}
    aria-hidden="true"
  >
    {product.data.size}
  </span>
  <img
    src={product.data.image}
    alt={product.data.title}
    width="550"
    height="550"
    loading="lazy"
    class="w-full rounded-[18px] object-contain"
  />
  <div class="flex items-center justify-between gap-3 px-3 pb-2 pt-4">
    <h3 class="min-h-[52px] text-left font-head2 text-[17px] leading-snug text-white">
      {product.data.title}
    </h3>
    <span
      class="inline-flex h-10 w-10 flex-none items-center justify-center rounded-full bg-brand text-ink transition-transform duration-300 group-hover:translate-x-1"
      aria-hidden="true"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
    </span>
  </div>
</a>
