{
  "name": "foodhacks-co",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Astro rebuild of foodhacks.co (migrated off WordPress)",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "deploy": "npm run build && gh-pages -d dist --dotfiles",
    "build:all": "bash scripts/build-all.sh",
