---
// Arabic home — live URL /ar/الرئيسية/ (the file name IS the live slug;
// served percent-encoded on the wire). /ar/ itself redirects here, as on
// the live WP site (see astro.config.mjs redirects).
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { routes } from '../../i18n';
import { withBase } from '../../utils/paths';

const products = (await getCollection('products', (p) => p.data.lang === 'ar')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout title="الرئيسية - فود هاكز" lang="ar" altHref={routes.home.en}>
  <!-- Hero banner (original .section-bg1): full-bleed, square corners,
       offset below the 90px fixed header (77px on mobile per the theme) -->
  <section
    class="mt-[77px] h-[320px] bg-cover bg-center md:mt-[90px] md:h-[500px]"
    style={`background-image: url('${withBase('/images/Banner_20Home_20Page.png')}');`}
    role="img"
    aria-label="فود هاكز — بخاخات طهي مبتكرة غير لاصقة"
  >
  </section>

  <!-- About intro (original .home-about, verbatim copy from live AR homepage) -->
  <section class="mx-auto max-w-[1180px] px-4 py-[60px]">
    <div class="grid items-center gap-10 md:grid-cols-2">
      <div class="text-center">
        <img
          src={withBase('/images/products.png')}
          alt="مجموعة بخاخات الطهي من فود هاكز"
          width="900"
          height="1440"
          class="mx-auto max-h-[520px] w-auto"
        />
      </div>
      <div>
        <h2 class="my-[15px] text-[44px] text-brand">فود هاكز</h2>
        <p class="mt-5">
          تقدم فود هاكز بخاخات طهي مبتكرة غير لاصقة تجمع بين الجودة والتنوع لجعل كل وجبة لذيذة
          وسهلة. استمتع بمجموعة متنوعة من المنتجات بما في ذلك بخاخ زيت الزيتون البكر الممتاز،
          وبخاخ زيت الزيتون الممتاز الخاص بنا، وبخاخ الزعفران الفاخر. كل منتج مصنوع من مكونات
          طبيعية 100%، مما يساعدك على تحضير وجبات صحية ولذيذة باستخدام كمية أقل من الدهون. اجعل
          تجربة الطبخ الخاصة بك أكثر تميز مع فود هاكز
        </p>
        <a href={withBase(routes.about.ar)} class="btn-brand mt-6">اعرف أكثر</a>
      </div>
    </div>

    <!-- رؤيتنا (original .content2.bg-green: 10/12-width green block,
         20px radius, 30px padding, white 44px h2; copy verbatim) -->
    <div class="mx-auto mt-14 w-full rounded-card bg-brand p-[30px] text-white md:w-10/12">
      <h2 class="my-[15px] text-[44px] !text-white">رؤيتنا</h2>
      <p class="mt-4">
        أن نكون رائدين في تقديم حلول طهي صحية وسهلة، نحقق أقصى قدر من الفوائد الصحية من خلال
        توفير طعام صحي يمكن الوصول إليه وسهل للجميع دون أي متاعب. نحن ملتزمون بتطوير منتجات
        وتقنيات مبتكرة تساهم في تعزيز أنماط الحياة الصحية، مع التركيز على استخدام المكونات
        الطبيعية وممارسات الطهي التي تضمن الحفاظ على القيم الغذائية والذوق الرفيع. هدفنا هو
        تمكين عملائنا من الاستمتاع بالطعام اللذيذ والصحي بأقل جهد وفي الوقت المناسب
      </p>
    </div>
  </section>

  <!-- Products grid (live: h3 36px FontHead2 heading, .panel-projects cards;
       the 2nd/3rd product titles are English on the live AR site too) -->
  <section class="mx-auto max-w-[1180px] px-4 pb-16">
    <h3 class="mb-5 text-center text-[36px]">منتجاتنا</h3>
    <div class="mt-10 grid gap-[30px] md:grid-cols-3">
      {products.map((product) => <ProductCard product={product} />)}
    </div>
    <p class="mt-10 text-center">
      <a href={withBase(routes.products.ar)} class="btn-brand">تسوق كل شيء</a>
    </p>
  </section>
</BaseLayout>
