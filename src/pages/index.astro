---
// Arabic home — now the site ROOT ("/"), the default locale (Bold-design
// promotion, 2026-07-12). /ar/ and /ar/الرئيسية/ both 301 here (see
// astro.config.mjs redirects).
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { routes, orderUrl, t } from '../i18n';
import { withBase } from '../utils/paths';

const products = (await getCollection('products', (p) => p.data.lang === 'ar')).sort(
  (a, b) => a.data.order - b.data.order
);

const faqs = (await getCollection('faqs', (f) => f.data.lang === 'ar'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const tilts = ['-6deg', '4deg', '-2deg'];
---

<BaseLayout title="الرئيسية - فود هاكز" lang="ar" altHref={routes.home.en}>
  <!-- ================= HERO — gradient mesh field, oversized type,
       overlapping rotated product renders ================= -->
  <section class="on-dark mesh-navy diag-bottom relative overflow-hidden pb-[calc(3.5vw+70px)] pt-[140px] text-white">
    <div class="dotgrid pointer-events-none absolute inset-0" aria-hidden="true"></div>

    <div class="relative mx-auto grid max-w-[1240px] items-center gap-14 px-4 lg:grid-cols-[7fr_5fr]">
      <div>
        <p class="sticker rotate-[-2deg] text-lime">{t.ar.heroTagline}</p>

        <h1 class="display mt-7 text-[clamp(56px,9vw,124px)] text-white">فود هاكز</h1>

        <p class="display mt-6 text-[clamp(20px,2.6vw,34px)] text-lime">
          {t.ar.heroSlogan}
        </p>

        <p class="mt-7 max-w-xl text-[17px] leading-[29px] text-white/85">
          تقدم فود هاكز بخاخات طهي مبتكرة غير لاصقة تجمع بين الجودة والتنوع لجعل كل وجبة لذيذة
          وسهلة. استمتع بمجموعة متنوعة من المنتجات بما في ذلك بخاخ زيت الزيتون البكر الممتاز،
          وبخاخ زيت الزيتون الممتاز الخاص بنا، وبخاخ الزعفران الفاخر. كل منتج مصنوع من مكونات
          طبيعية 100%، مما يساعدك على تحضير وجبات صحية ولذيذة باستخدام كمية أقل من الدهون. اجعل
          تجربة الطبخ الخاصة بك أكثر تميز مع فود هاكز
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-4">
          <a href={orderUrl.ar} target="_blank" rel="noopener" class="btn-cta">{t.ar.orderNow}</a>
          <a href={withBase(routes.products.ar)} class="btn-ghost">منتجاتنا</a>
        </div>
      </div>

      <!-- overlapping rotated renders -->
      <div class="relative mx-auto h-[430px] w-full max-w-[420px] sm:h-[470px]" aria-hidden="true">
        {products.map((p, i) => (
          <img
            src={withBase(p.data.image)}
            alt=""
            width="512"
            height="512"
            loading={i === 0 ? 'eager' : 'lazy'}
            class:list={[
              'render-card floaty absolute w-[58%]',
              i === 0 && 'start-0 top-0 z-10',
              i === 1 && 'end-0 top-[16%] z-20',
              i === 2 && 'start-[18%] top-[42%] z-30',
            ]}
            style={`--tilt: ${tilts[i]}; animation-delay: ${i * 0.9}s; transform: rotate(${tilts[i]});`}
          />
        ))}
        <span class="sticker-solid absolute -start-2 top-[46%] z-40 rotate-[-8deg]">100% طبيعي</span>
        <span class="sticker absolute end-0 top-[74%] z-40 rotate-[5deg] text-lime">دهون أقل</span>
      </div>
    </div>
  </section>

  <!-- ================= SPRAY IN NUMBERS — animated counter strip ========= -->
  <section class="mesh-green diag-both -mt-[3.5vw] px-4 py-[calc(3.5vw+44px)]" aria-label="فود هاكز بالأرقام">
    <div class="mx-auto grid max-w-[1180px] grid-cols-2 gap-x-6 gap-y-10 text-center text-ink lg:grid-cols-4">
      <div class="reveal">
        <p class="display text-[clamp(44px,5vw,72px)]"><span data-count="100">100</span>%</p>
        <p class="eyebrow mt-2 !tracking-[0.2em]">{t.ar.statNatural}</p>
      </div>
      <div class="reveal reveal-d1">
        <p class="display text-[clamp(44px,5vw,72px)]"><span data-count="3">3</span></p>
        <p class="eyebrow mt-2 !tracking-[0.2em]">{t.ar.statSprays}</p>
      </div>
      <div class="reveal reveal-d2">
        <p class="display text-[clamp(44px,5vw,72px)]"><span data-count="24">24</span></p>
        <p class="eyebrow mt-2 !tracking-[0.2em]">{t.ar.statDelivery}</p>
      </div>
      <div class="reveal reveal-d3">
        <p class="display text-[clamp(44px,5vw,72px)]"><span data-count="0">0</span></p>
        <p class="eyebrow mt-2 !tracking-[0.2em]">{t.ar.statPreservatives}</p>
      </div>
    </div>
  </section>

  <!-- ================= BRAND INTRO — asymmetric split (verbatim copy) ====== -->
  <section class="mx-auto max-w-[1180px] px-4 pb-8 pt-20">
    <div class="grid items-center gap-12 md:grid-cols-2">
      <div class="reveal relative order-2 md:order-1">
        <div class="absolute -start-4 -top-4 h-full w-full rounded-[24px] bg-brand/20" aria-hidden="true"></div>
        <img
          src={withBase('/images/products.png')}
          alt="مجموعة بخاخات الطهي من فود هاكز"
          width="900"
          height="1440"
          loading="lazy"
          class="render-card relative mx-auto max-h-[540px] w-auto rotate-[-2deg] bg-white"
        />
      </div>
      <div class="reveal reveal-d1 order-1 md:order-2">
        <p class="sticker rotate-[2deg] text-brand-deep">{t.ar.theBrand}</p>
        <h2 class="display mt-5 text-[clamp(38px,4.5vw,64px)] text-ink">فود هاكز</h2>
        <p class="mt-6 text-[17px] leading-[29px]">
          تقدم فود هاكز بخاخات طهي مبتكرة غير لاصقة تجمع بين الجودة والتنوع لجعل كل وجبة لذيذة
          وسهلة. استمتع بمجموعة متنوعة من المنتجات بما في ذلك بخاخ زيت الزيتون البكر الممتاز،
          وبخاخ زيت الزيتون الممتاز الخاص بنا، وبخاخ الزعفران الفاخر. كل منتج مصنوع من مكونات
          طبيعية 100%، مما يساعدك على تحضير وجبات صحية ولذيذة باستخدام كمية أقل من الدهون. اجعل
          تجربة الطبخ الخاصة بك أكثر تميز مع فود هاكز
        </p>
        <a href={withBase(routes.about.ar)} class="btn-cta mt-8">{t.ar.readMore}</a>
      </div>
    </div>
  </section>

  <!-- ================= OUR VISION — bold navy statement block ============== -->
  <section class="mx-auto max-w-[1180px] px-4 py-16">
    <div class="on-dark mesh-navy tile reveal relative overflow-hidden p-8 text-white md:p-14">
      <div class="dotgrid pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="relative md:w-10/12">
        <p class="sticker rotate-[-2deg] text-lime">{t.ar.whereHeaded}</p>
        <h2 class="display mt-5 text-[clamp(38px,4.5vw,64px)] text-brand">{t.ar.visionTitle}</h2>
        <p class="mt-6 text-[17px] leading-[29px] text-white/85">
          أن نكون رائدين في تقديم حلول طهي صحية وسهلة، نحقق أقصى قدر من الفوائد الصحية من خلال
          توفير طعام صحي يمكن الوصول إليه وسهل للجميع دون أي متاعب. نحن ملتزمون بتطوير منتجات
          وتقنيات مبتكرة تساهم في تعزيز أنماط الحياة الصحية، مع التركيز على استخدام المكونات
          الطبيعية وممارسات الطهي التي تضمن الحفاظ على القيم الغذائية والذوق الرفيع. هدفنا هو
          تمكين عملائنا من الاستمتاع بالطعام اللذيذ والصحي بأقل جهد وفي الوقت المناسب
        </p>
      </div>
      <span class="absolute -start-4 top-8 hidden md:block" aria-hidden="true">
        <span class="sticker-solid rotate-[8deg]">{t.ar.healthyEasy}</span>
      </span>
    </div>
  </section>

  <!-- ================= BENTO — products + benefits + FAQ teaser ============ -->
  <section class="mx-auto max-w-[1180px] px-4 pb-24">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 class="display text-[clamp(38px,4.5vw,64px)] text-ink">منتجاتنا</h2>
      <p class="sticker mb-2 rotate-[-2deg] text-brand-deep">{t.ar.pickFlavour}</p>
    </div>

    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {products.map((product, i) => (
        <div class:list={['reveal', i === 1 && 'reveal-d1 md:translate-y-6', i === 2 && 'reveal-d2']}>
          <ProductCard product={product} tilt={i % 2 === 0 ? -3 : 3} />
        </div>
      ))}

      <!-- benefit tile -->
      <div class="tile reveal mesh-green flex flex-col justify-between p-8 text-ink md:col-span-1">
        <p class="display text-[clamp(30px,3vw,44px)] leading-none">{t.ar.benefitHeadline}</p>
        <p class="mt-6 font-head2 text-[15px] leading-[26px]">
          {t.ar.benefitBody}
        </p>
      </div>

      <!-- FAQ teaser tile (real questions from the collection) -->
      <div class="on-dark tile reveal reveal-d1 bg-ink p-8 text-white md:col-span-1">
        <p class="eyebrow text-lime">{t.ar.goodToKnow}</p>
        <ul class="mt-5 space-y-4">
          {faqs.map((faq) => (
            <li class="border-b border-white/15 pb-4 font-head2 text-[15px] leading-snug text-white/90">
              {faq.data.question}
            </li>
          ))}
        </ul>
        <a href={withBase(routes.faqs.ar)} class="btn-ghost mt-6 !px-6 !py-2.5 !text-[13px]">{t.ar.allFaqsCta}</a>
      </div>

      <!-- shop-all tile -->
      <div class="reveal reveal-d2">
        <div class="tile tile-hover relative h-full overflow-hidden border-2 border-ink bg-white p-8">
          <p class="display text-[clamp(30px,3vw,44px)] leading-none text-ink">{t.ar.makeEveryMealSpecial}</p>
          <a href={withBase(routes.products.ar)} class="btn-cta mt-8">{t.ar.shopAllCta}</a>
          <span class="sticker absolute -end-3 bottom-6 rotate-[-8deg] text-brand-deep" aria-hidden="true">{t.ar.zeroHassle}</span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
