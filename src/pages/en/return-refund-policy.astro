---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { routes, t } from '../../i18n';
---

<BaseLayout
  title="Return & Refund Policy - Food Hacks"
  description="Food Hacks return and refund policy: replacements and refunds within 14 days, and manufacturing-defect resolution within 30 days."
  lang="en"
  altHref={routes.policy.ar}
>
  <PageHero title="Return & Refund Policy" subtitle={t.en.fairSimple} />

  <section class="mx-auto max-w-4xl space-y-8 px-4 pb-24 pt-16">
    <!-- 14-day card -->
    <div class="tile reveal border-2 border-ink bg-white p-8 shadow-[8px_8px_0_rgba(141,191,68,0.9)] md:p-10">
      <div class="flex items-baseline gap-4">
        <span class="display text-[clamp(40px,5vw,64px)] text-brand-deep" aria-hidden="true">14</span>
        <p class="font-head text-[19px] text-ink"><b>Replacement and Refund Within 14 Days</b></p>
      </div>
      <p class="mt-5">
        If you change your mind about your Food Hacks purchase, you may request a replacement or
        refund under the following conditions:
      </p>
      <ul class="mt-4 list-disc space-y-2 ps-6 marker:text-brand-deep">
        <li><b>Timeframe:</b> Contact us within 14 days of the purchase date.</li>
        <li><b>Condition:</b> The product must be in its original, unopened, and unused condition.</li>
        <li><b>Proof of Purchase:</b> Please provide your receipt or other proof of purchase.</li>
        <li><b>Shipping Fees:</b> Shipping fees are non-refundable.</li>
      </ul>
      <h3 class="mt-6 font-head text-[17px] text-ink">How to Request a Return or Exchange</h3>
      <p class="mt-3">
        To initiate a return or exchange, simply contact our customer service team with your order
        details and the reason for the return. We will guide you through the return or exchange
        process.
      </p>
    </div>

    <!-- 30-day card -->
    <div class="on-dark tile reveal reveal-d1 mesh-navy relative overflow-hidden p-8 text-white md:p-10">
      <div class="dotgrid pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="relative">
        <div class="flex items-baseline gap-4">
          <span class="display text-[clamp(40px,5vw,64px)] text-brand" aria-hidden="true">30</span>
          <p class="font-head text-[19px] text-white"><b>Manufacturing Defects (Within 30 Days)</b></p>
        </div>
        <p class="mt-5 text-white/85">
          At Food Hacks, we are committed to providing high-quality products. If you discover a
          manufacturing defect, you may request a replacement or refund under the following
          conditions:
        </p>
        <ul class="mt-4 list-disc space-y-2 ps-6 text-white/85 marker:text-brand">
          <li><b class="text-white">Timeframe:</b> Contact us within 30 days of the purchase date.</li>
          <li><b class="text-white">Condition:</b> The issue must be due to a manufacturing defect.</li>
          <li><b class="text-white">Proof of Purchase:</b> Please provide your receipt or other proof of purchase.</li>
        </ul>
        <h3 class="mt-6 font-head text-[17px] text-white">How to Report a Manufacturing Defect</h3>
        <p class="mt-3 text-white/85">
          Please contact our customer service team with your order details and a description of the
          issue. Our team will assess the defect and guide you through the next steps, which may
          include a replacement or a refund.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
