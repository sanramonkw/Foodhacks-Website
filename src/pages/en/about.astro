---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { routes, t } from '../../i18n';
import { withBase } from '../../utils/paths';

const aboutPage = {
  '@type': 'AboutPage',
  '@id': 'https://foodhacks.co/en/about/',
  url: 'https://foodhacks.co/en/about/',
  name: 'About us - Food Hacks',
  about: { '@id': 'https://foodhacks.co/#organization' },
};
---

<BaseLayout title="About us - Food Hacks" lang="en" altHref={routes.about.ar} schema={[aboutPage]}>
  <PageHero title="About us" subtitle={t.en.whoWeAre} />

  <!-- Section 1: About Food Hacks (copy verbatim) -->
  <section class="mx-auto max-w-[1180px] px-4 pb-8 pt-16">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 class="display text-[clamp(34px,4vw,56px)] text-ink">About Food Hacks</h2>
      <p class="sticker mb-2 rotate-[-2deg] text-brand-deep">{t.en.reinventingCooking}</p>
    </div>

    <div class="mt-10 grid items-start gap-12 md:grid-cols-2">
      <div class="reveal relative">
        <div class="absolute -start-4 -top-4 h-full w-full rounded-[24px] bg-brand/20" aria-hidden="true"></div>
        <img
          src={withBase('/images/fh-products.png')}
          alt="About Food Hacks — product range"
          width="897"
          height="897"
          loading="lazy"
          class="render-card relative mx-auto w-full max-w-[520px] rotate-[-2deg] bg-white"
        />
      </div>
      <div class="reveal reveal-d1 space-y-4">
        <p><b>Welcome to Food Hacks, where we reinvent the art of cooking.</b></p>
        <p>
          Discover the cooking spray that is changing the game of cooking. Designed to be your
          essential kitchen companion, it offers an innovative and easy solution to all your
          cooking needs.
        </p>
        <p>
          At Food Hacks, we focus on simplifying the cooking process by offering healthy and easy
          methods. We are here to make every meal an opportunity to enjoy and experience something
          new in the kitchen.
        </p>
        <p>
          Cook healthy and easy with Food Hacks spray. This product allows you to use a small
          amount of oil evenly, reducing mess and promoting a healthy lifestyle. Monitor your
          calorie intake effectively and enjoy delicious food without the need for large amounts
          of oil.
        </p>
        <p>Food Hacks spray has several aspects that make it an attractive choice for many people:</p>
        <p>1.&#8288; &#8288;Ideal Size: The size of the spray allows you to use it easily in the kitchen without taking up a lot of space or being heavy.</p>
        <p>2.&#8288; &#8288;Non-stick Experience: Food Hacks spray is characterized by its ability to provide a non-stick cooking experience, reducing the need to use excessive oils or fats.</p>
        <p>3.&#8288; &#8288;Multiple Use: It can be used for several purposes in cooking, from spraying ingredients with oil to improving the overall flavor of foods.</p>
        <p>4.&#8288; &#8288;Low Calories: The spray helps reduce the amount of oil or fat used, which contributes to reducing the calories in food.</p>
        <p>
          These features make Food Hacks spray a useful choice for those looking to improve their
          cooking experience in healthy and practical ways.
        </p>
      </div>
    </div>
  </section>

  <!-- Section 2: Head Office (copy per the owner's 2026-08 review sheet) — navy block -->
  <section class="mx-auto max-w-[1180px] px-4 pb-24 pt-12">
    <div class="on-dark mesh-navy tile reveal relative overflow-hidden p-8 text-white md:p-14">
      <div class="dotgrid pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="relative">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <h2 class="display text-[clamp(34px,4vw,56px)] text-brand">{t.en.ourFactory}</h2>
          <p class="sticker mb-2 rotate-[2deg] text-lime">{t.en.sinceKuwait}</p>
        </div>

        <div class="mt-10 grid items-start gap-12 md:grid-cols-2">
          <img
            src={withBase('/images/san_20remon.png')}
            alt="San Ramon head office"
            width="1494"
            height="940"
            loading="lazy"
            class="render-card mx-auto w-full rotate-[1deg]"
          />
          <div class="space-y-4 text-white/85">
            <h3 class="font-head text-[19px] text-brand">About San Ramon</h3>
            <p class="text-white">
              <b>
                Established in 2004, San Ramon is a leading Kuwaiti company committed to delivering
                high-quality products and services while building strong brands that meet the
                evolving needs of local, regional, and international markets.
              </b>
            </p>
            <p>
              The company&rsquo;s journey began with the import and supply of products for the oil and
              gas sector. In 2012, San Ramon expanded into the food and beverage industry, becoming
              the home of several successful brands, including Food Hacks, Karak Tea, Shahad Honey,
              and Food Experts, all recognized for their quality and commitment to excellence.
            </p>
            <p>
              As part of its continuous growth strategy, San Ramon further diversified its business by
              launching its Beauty Division in 2013, expanding into the Caf&eacute;s &amp; Restaurants
              Division in 2015, and introducing its Interior Design Division in 2018. This diversified
              portfolio reflects the company&rsquo;s vision of creating value across multiple
              industries.
            </p>
            <p>
              Today, San Ramon continues to strengthen its presence in local and international markets
              by investing in innovation, expanding its portfolio of brands, and growing its
              distribution network. With a strong commitment to quality, reliability, and customer
              satisfaction, San Ramon remains focused on delivering excellence and building lasting
              partnerships for the future.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
