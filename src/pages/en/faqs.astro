---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { routes, t } from '../../i18n';

const faqs = (await getCollection('faqs', (f) => f.data.lang === 'en')).sort(
  (a, b) => a.data.order - b.data.order
);
const rendered = await Promise.all(
  faqs.map(async (faq) => ({ faq, Content: (await render(faq)).Content }))
);

// FAQPage rich-result schema (big GEO/SEO win over the WP accordion)
const faqSchema = {
  '@type': 'FAQPage',
  '@id': 'https://foodhacks.co/en/faqs/#faq',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.data.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.body?.trim() ?? '' },
  })),
};
---

<BaseLayout
  title="FAQs - Food Hacks"
  description="Frequently asked questions about Food Hacks healthy non-stick cooking sprays: ingredients, heat resistance, delivery, and usage."
  lang="en"
  altHref={routes.faqs.ar}
  schema={[faqSchema]}
>
  <PageHero title="FAQs" subtitle={t.en.everythingAboutSpray} />

  <!-- bold numbered accordion — native <details>, no JS -->
  <section class="mx-auto max-w-[1180px] px-4 pb-24 pt-16">
    <div class="mx-auto w-full md:w-9/12">
      {rendered.map(({ faq, Content }, i) => (
        <div class="reveal">
          <details class="faq-item">
            <summary>
              <span class="faq-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              {faq.data.question}
              <span class="faq-icon" aria-hidden="true"></span>
            </summary>
            <div class="faq-answer">
              <Content />
            </div>
          </details>
        </div>
      ))}

      <p class="mt-10 text-center">
        <a href={routes.contact.en} class="btn-cta">{t.en.stillCurious}</a>
      </p>
    </div>
  </section>
</BaseLayout>
