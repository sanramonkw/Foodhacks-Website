---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductCard from '../../../components/ProductCard.astro';
import { productPath, routes, t } from '../../../i18n';
import { withBase } from '../../../utils/paths';

export async function getStaticPaths() {
  const all = await getCollection('products');
  return all
    .filter((product) => product.data.lang === 'en')
    .map((product) => ({
      params: { slug: product.id },
      props: {
        product,
        // AR counterpart (paired via translationKey) for hreflang + the
        // العربية switcher. NOTE: live Polylang left the saffron pair
        // unlinked ("no-translation" — its switcher fell back to the AR
        // home); we link the real counterpart instead.
        arCounterpart:
          all.find(
            (p) => p.data.lang === 'ar' && p.data.translationKey === product.data.translationKey
          )?.id ?? null,
      },
    }));
}

interface Props {
  product: CollectionEntry<'products'>;
  arCounterpart: string | null;
}
const { product, arCounterpart } = Astro.props;
const { Content } = await render(product);
const altHref = arCounterpart ? productPath('ar', arCounterpart) : undefined;

// the other two flavours, for the cross-sell strip
const others = (await getCollection('products'))
  .filter((p) => p.data.lang === 'en' && p.id !== product.id)
  .sort((a, b) => a.data.order - b.data.order);

const productSchema = {
  '@type': 'Product',
  '@id': `https://foodhacks.co/en/product/${product.id}/#product`,
  name: product.data.title,
  image: new URL(product.data.image, 'https://foodhacks.co').href,
  description: product.data.description,
  brand: { '@type': 'Brand', name: 'Food Hacks' },
  manufacturer: { '@id': 'https://foodhacks.co/#organization' },
  offers: {
    '@type': 'Offer',
    url: product.data.orderUrl,
    availability: 'https://schema.org/InStock',
  },
};
---

<BaseLayout
  title={`${product.data.title} - Food Hacks`}
  description={product.data.description}
  ogImage={product.data.image}
  ogType="product"
  schema={[productSchema]}
  lang="en"
  altHref={altHref}
>
  <!-- BOLD product hero: navy mesh split — oversized title + verbatim body
       on the left, rotated studio render on the right. (The live product
       pages have no body copy below the banner; this composed section is a
       deliberate rebuild addition — see CLAUDE.md content notes.) -->
  <section class="on-dark mesh-navy diag-bottom relative overflow-hidden px-4 pb-[calc(3.5vw+70px)] pt-[150px] text-white">
    <div class="dotgrid pointer-events-none absolute inset-0" aria-hidden="true"></div>

    <div class="relative mx-auto grid max-w-[1180px] items-center gap-12 md:grid-cols-2">
      <div>
        <p class="sticker rotate-[-2deg] text-lime">{product.data.size} &middot; {t.en.hundredPercentNatural}</p>
        <h1 class="display mt-6 text-[clamp(38px,5vw,72px)] text-white">
          {product.data.title}
        </h1>
        <div class="mt-7 h-[4px] w-[110px] rounded-full bg-brand"></div>
        <div class="mt-7 max-w-xl space-y-4 text-[17px] text-white/85 [&_p]:leading-[29px]">
          <Content />
        </div>
        <div class="mt-9 flex flex-wrap items-center gap-4">
          <a href={product.data.orderUrl} target="_blank" rel="noopener" class="btn-cta">
            {t.en.orderNow}
          </a>
          <a href={withBase(routes.products.en)} class="btn-ghost">{t.en.allProductsCta}</a>
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-[440px]">
        <div class="absolute -start-5 -top-5 h-full w-full rounded-[24px] bg-brand/25 rotate-[3deg]" aria-hidden="true"></div>
        <img
          src={withBase(product.data.image)}
          alt={product.data.title}
          width="1024"
          height="1024"
          class="render-card floaty relative w-full bg-white"
          style="--tilt: -3deg; transform: rotate(-3deg);"
        />
        <span class="sticker-solid absolute -bottom-3 start-6 rotate-[-5deg]" aria-hidden="true">
          {product.data.size}
        </span>
      </div>
    </div>
  </section>

  <!-- cross-sell: the other two flavours -->
  <section class="mx-auto max-w-[1180px] px-4 pb-24 pt-14" aria-label="More flavours">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 class="display text-[clamp(30px,3.6vw,48px)] text-ink">{t.en.moreFlavours}</h2>
      <p class="sticker mb-2 rotate-[-2deg] text-brand-deep">{t.en.completeSet}</p>
    </div>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {others.map((p, i) => (
        <div class:list={['reveal', i === 1 && 'reveal-d1']}>
          <ProductCard product={p} tilt={i % 2 === 0 ? -3 : 3} />
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
