---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { routes, t } from '../i18n';
import { withBase } from '../utils/paths';

const aboutPage = {
  '@type': 'AboutPage',
  '@id': 'https://foodhacks.co/about-ar/',
  url: 'https://foodhacks.co/about-ar/',
  name: 'من نحن - فود هاكس',
  inLanguage: 'ar',
  about: { '@id': 'https://foodhacks.co/#organization' },
};
---

<BaseLayout title="من نحن - فود هاكس" lang="ar" altHref={routes.about.en} schema={[aboutPage]}>
  <PageHero title="من نحن" subtitle={t.ar.whoWeAre} />

  <!-- Section 1: عن فود هاكس (copy per the owner's 2026-08 review sheet) -->
  <section class="mx-auto max-w-[1180px] px-4 pb-8 pt-16">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 class="display text-[clamp(34px,4vw,56px)] text-ink">عن فود هاكس</h2>
      <p class="sticker mb-2 rotate-[-2deg] text-brand-deep">{t.ar.reinventingCooking}</p>
    </div>

    <div class="mt-10 grid items-start gap-12 md:grid-cols-2">
      <div class="reveal relative">
        <div class="absolute -start-4 -top-4 h-full w-full rounded-[24px] bg-brand/20" aria-hidden="true"></div>
        <img
          src={withBase('/images/fh-products.png')}
          alt="من نحن — مجموعة منتجات فود هاكس"
          width="897"
          height="897"
          loading="lazy"
          class="render-card relative mx-auto w-full max-w-[520px] rotate-[-2deg] bg-white"
        />
      </div>
      <div class="reveal reveal-d1 space-y-4">
        <p><b>مرحبًا بكم في فود هاكس</b></p>
        <p>
          في فود هاكس، نؤمن بأن الطهي يجب أن يكون أسهل، أكثر صحة، وأكثر متعة. لذلك نطوّر منتجات
          مبتكرة تساعدكم على تحضير وجباتكم اليومية بكل سهولة، مع الحفاظ على المذاق الذي تحبونه.
        </p>
        <p>
          يُعد رذاذ الطبخ من فود هاكس الحل الأمثل للتحكم في كمية الزيت المستخدمة أثناء الطهي، حيث
          يوفر توزيعًا متساويًا بكمية أقل، مما يساعد على تقليل استهلاك الدهون والسعرات الحرارية،
          ويمنحكم تجربة طهي عملية ونظيفة.
        </p>
        <h3 class="font-head text-[19px] text-ink">لماذا رذاذ فود هاكس؟</h3>
        <ul class="list-disc space-y-2 ps-6 marker:text-brand-deep">
          <li>
            <b>الحجم المثالي:</b> تصميم عملي وسهل الاستخدام والتخزين، يناسب جميع المطابخ.
          </li>
          <li>
            <b>طهي غير لاصق:</b> يساعد على تقليل التصاق الطعام ويحد من الحاجة إلى استخدام كميات
            كبيرة من الزيت.
          </li>
          <li>
            <b>متعدد الاستخدامات:</b> مناسب للمقالي، والشوايات، وصواني الخبز، والخضروات،
            والسلطات، وغيرها من الاستخدامات اليومية.
          </li>
          <li>
            <b>خيار صحي:</b> يساهم في التحكم بكمية الزيت المستخدمة، مما يدعم أسلوب حياة أكثر
            توازنًا.
          </li>
        </ul>
        <p>
          في فود هاكس، نسعى إلى تقديم حلول مبتكرة تجعل الطهي اليومي أسهل وأكثر راحة، مع المحافظة
          على الجودة والمذاق في كل وجبة.
        </p>
      </div>
    </div>
  </section>

  <!-- Section 2: المقر الرئيسي (copy per the owner's 2026-08 review sheet) — navy block -->
  <section class="mx-auto max-w-[1180px] px-4 pb-24 pt-12">
    <div class="on-dark mesh-navy tile reveal relative overflow-hidden p-8 text-white md:p-14">
      <div class="dotgrid pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="relative">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <h2 class="display text-[clamp(34px,4vw,56px)] text-brand">{t.ar.ourFactory}</h2>
          <p class="sticker mb-2 rotate-[2deg] text-lime">{t.ar.sinceKuwait}</p>
        </div>

        <div class="mt-10 grid items-start gap-12 md:grid-cols-2">
          <img
            src={withBase('/images/san_20remon.png')}
            alt="المقر الرئيسي لشركة سان ريمون"
            width="1494"
            height="940"
            loading="lazy"
            class="render-card mx-auto w-full rotate-[1deg]"
          />
          <div class="space-y-4 text-white/85">
            <h3 class="font-head text-[19px] text-brand">عن سان ريمون</h3>
            <p class="text-white">
              <b>
                منذ تأسيسها عام 2004، رسخت سان ريمون مكانتها كشركة كويتية رائدة، انطلقت برؤية واضحة
                تقوم على تقديم حلول ومنتجات عالية الجودة، وبناء علامات تجارية تلبي احتياجات الأسواق
                المحلية والعالمية.
              </b>
            </p>
            <p>
              بدأت الشركة أعمالها في استيراد وتوريد احتياجات قطاع النفط والغاز، مستندةً إلى أعلى
              معايير الجودة والموثوقية. ومع تطور أعمالها وتوسع رؤيتها، دخلت سان ريمون عام 2012 قطاع
              الأغذية والمشروبات، الذي أصبح اليوم أحد أهم ركائز الشركة، حيث تقوم بتطوير وتصنيع
              وتوزيع مجموعة من العلامات التجارية المتميزة، من أبرزها فود هاكس وشاي كرك وعسل شهد
              وفود إكسبرتز.
            </p>
            <p>
              واستمرارًا لنهجها في النمو والابتكار، وسّعت سان ريمون نطاق أعمالها ليشمل العديد من
              القطاعات، فأطلقت قسم منتجات التجميل في عام 2013، ثم أسست قطاع المقاهي والمطاعم عام
              2015، قبل أن تضيف قسم التصميم الداخلي في عام 2018، لتصبح شركة متعددة الأنشطة تجمع بين
              التصنيع والتوزيع والخدمات تحت مظلة واحدة.
            </p>
            <p>
              واليوم، تواصل سان ريمون الاستثمار في الابتكار، وتطوير المنتجات، وبناء علامات تجارية
              ذات قيمة حقيقية، مع التركيز على الجودة والاستدامة والتوسع في الأسواق الإقليمية
              والعالمية. ومن خلال خبرتها الممتدة ورؤيتها المستقبلية، تسعى الشركة إلى تقديم منتجات
              وخدمات ترتقي بتوقعات العملاء وتحقق قيمة مستدامة لشركائها، لتواصل مسيرتها بثقة نحو
              آفاق جديدة من النمو والنجاح.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
