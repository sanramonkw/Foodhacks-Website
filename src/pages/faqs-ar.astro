---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { routes, t } from '../i18n';
import { withBase } from '../utils/paths';

const faqs = (await getCollection('faqs', (f) => f.data.lang === 'ar')).sort(
  (a, b) => a.data.order - b.data.order
);
const rendered = await Promise.all(
  faqs.map(async (faq) => ({ faq, Content: (await render(faq)).Content }))
);

const faqSchema = {
  '@type': 'FAQPage',
  '@id': 'https://foodhacks.co/faqs-ar/#faq',
  inLanguage: 'ar',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.data.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.body?.trim() ?? '' },
  })),
};
---

<BaseLayout
  title="الأسئلة الشائعة - فود هاكس"
  lang="ar"
  altHref={routes.faqs.en}
  schema={[faqSchema]}
>
  <PageHero title="الأسئلة الشائعة" subtitle={t.ar.everythingAboutSpray} />

  <!-- bold numbered accordion — native <details>, no JS -->
  <section class="mx-auto max-w-[1180px] px-4 pb-24 pt-16">
    <div class="mx-auto w-full md:w-9/12">
      {rendered.map(({ faq, Content }, i) => (
        <div class="reveal">
          <details class="faq-item">
            <summary>
              <span class="faq-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              {faq.data.question}
              <span class="faq-icon" aria-hidden="true"></span>
            </summary>
            <div class="faq-answer">
              <Content />
            </div>
          </details>
        </div>
      ))}

      <div class="mt-10 text-center">
        <p class="font-head2 text-[17px] text-ink">{t.ar.stillCurious}</p>
        <a href={withBase(routes.contact.ar)} class="btn-cta mt-5">{t.ar.contactCta}</a>
      </div>
    </div>
  </section>
</BaseLayout>
