---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ProductCard from '../components/ProductCard.astro';
import { routes } from '../i18n';

const products = (await getCollection('products', (p) => p.data.lang === 'en')).sort(
  (a, b) => a.data.order - b.data.order
);

const itemList = {
  '@type': 'ItemList',
  '@id': 'https://foodhacks.co/products/#itemlist',
  name: 'Food Hacks Products',
  itemListElement: products.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `https://foodhacks.co/product/${p.id}/`,
    name: p.data.title,
  })),
};
---

<BaseLayout
  title="Our Products - Food Hacks"
  description="The Food Hacks range: Saffron Spray, Extra Virgin Olive Oil Spray, and Truffle Flavoured Extra Virgin Olive Oil Spray — 100% natural non-stick cooking sprays."
  schema={[itemList]}
  altHref={routes.products.ar}
>
  <PageHero title="Our Products" />

  <!-- live /products/: just the 3 .panel-projects cards, no extra button -->
  <section class="mx-auto max-w-[1180px] px-4 py-[60px]">
    <div class="grid gap-[30px] md:grid-cols-3">
      {products.map((product) => <ProductCard product={product} />)}
    </div>
  </section>
</BaseLayout>
