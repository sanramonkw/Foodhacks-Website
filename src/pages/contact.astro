---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { routes } from '../i18n';

const contactPage = {
  '@type': 'ContactPage',
  '@id': 'https://foodhacks.co/contact/',
  url: 'https://foodhacks.co/contact/',
  name: 'Contact Us - Food Hacks',
  about: { '@id': 'https://foodhacks.co/#organization' },
};
---

<BaseLayout title="Contact Us - Food Hacks" schema={[contactPage]} altHref={routes.contact.ar}>
  <PageHero title="Contact Us" subtitle="Get in Touch" />

  <section class="mx-auto max-w-[1180px] px-4 py-[60px]">
    <div class="grid gap-12 md:grid-cols-[4fr_1fr_7fr]">
      <div>
        <h5 class="text-[18px]">
          <a href="tel:+96522204332" class="inline-flex items-center gap-2 transition-colors hover:text-link-hover">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.85 21 3 13.15 3 3.5a1 1 0 0 1 1-1H7.5a1 1 0 0 1 1 1c0 1.24.2 2.45.57 3.57a1 1 0 0 1-.24 1.02l-2.21 2.2Z"/></svg>
            +965 22204332
          </a>
        </h5>
        <hr class="my-5 border-rule" />
        <h5 class="text-[18px]">
          <a href="mailto:info@foodhacks.co" class="inline-flex items-center gap-2 transition-colors hover:text-link-hover">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6L22 7"/></svg>
            info@foodhacks.co
          </a>
        </h5>
      </div>

      <div class="hidden md:block"></div>

      <!-- original .section-light card with underline-style CF7 fields -->
      <div class="rounded-[16px] border border-black/10 bg-white/90 px-[30px] py-5 shadow-[0_8px_16px_rgba(0,0,0,0.05)]">
        <h4 class="my-[15px] text-[22px]">For general inquiries, please fill out the form below:</h4>
        <!--
          TODO: the WP site used Contact Form 7 + reCAPTCHA v3. This static form
          needs a backend: wire `action` to a form service (Formspree/Basin) or a
          serverless endpoint before launch.
        -->
        <form method="post" action="#" class="mt-6 space-y-4">
          <input type="text" name="your-name" placeholder="Name" required maxlength="400" class="field-line" />
          <input type="email" name="your-email" placeholder="Email" required maxlength="400" class="field-line" />
          <input type="tel" name="your-phone" placeholder="Phone" required maxlength="400" class="field-line" />
          <textarea name="your-message" placeholder="Message" rows="6" maxlength="2000" class="field-line"></textarea>
          <!-- live CF7 submit: full-width, 20px font, 20px padding -->
          <button type="submit" class="btn-brand w-full !p-5 !text-[20px]">Submit</button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
