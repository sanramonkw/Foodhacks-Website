---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { routes, t } from '../i18n';
---

<BaseLayout
  title="سياسة الإرجاع واسترداد الأموال - فود هاكس"
  description="سياسة الإرجاع واسترداد الأموال لدى فود هاكس: الاستبدال والاسترداد خلال 14 يومًا، ومعالجة عيوب التصنيع خلال 30 يومًا."
  lang="ar"
  altHref={routes.policy.en}
>
  <PageHero title="سياسة الإرجاع واسترداد الأموال" subtitle={t.ar.fairSimple} />

  <!-- copy rewritten per the owner's 2026-08 review sheet (the old live-site
       stray leading periods / word-joiner characters are gone with it) -->
  <section class="mx-auto max-w-4xl space-y-8 px-4 pb-24 pt-16">
    <div class="tile reveal border-2 border-ink bg-white p-8 shadow-[8px_8px_0_rgba(141,191,68,0.9)] md:p-10">
      <div class="flex items-baseline gap-4">
        <span class="display text-[clamp(40px,5vw,64px)] text-brand-deep" aria-hidden="true">14</span>
        <p class="font-head text-[19px] text-ink"><b>الاستبدال والاسترداد خلال 14 يومًا</b></p>
      </div>
      <p class="mt-5">
        إذا غيرت رأيك بعد شراء منتج فود هاكس، يمكنك طلب استبدال المنتج أو استرداد قيمته وفقًا
        للشروط التالية:
      </p>
      <ul class="mt-4 list-disc space-y-2 ps-6 marker:text-brand-deep">
        <li><b>المدة:</b> يجب التواصل معنا خلال 14 يومًا من تاريخ الشراء.</li>
        <li><b>حالة المنتج:</b> يجب أن يكون المنتج بحالته الأصلية، غير مفتوح وغير مستخدم.</li>
        <li><b>إثبات الشراء:</b> يُرجى الاحتفاظ بالفاتورة أو إثبات الشراء وتقديمه عند الطلب.</li>
        <li><b>رسوم الشحن:</b> رسوم الشحن غير قابلة للاسترداد.</li>
      </ul>
      <h3 class="mt-6 font-head text-[17px] text-ink">كيفية طلب الاستبدال أو الاسترداد</h3>
      <p class="mt-3">
        لبدء طلب الاستبدال أو الاسترداد، يُرجى التواصل مع فريق خدمة العملاء وتزويدنا برقم الطلب
        وسبب الإرجاع، وسنرشدك إلى خطوات إتمام العملية.
      </p>
    </div>

    <div class="on-dark tile reveal reveal-d1 mesh-navy relative overflow-hidden p-8 text-white md:p-10">
      <div class="dotgrid pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="relative">
        <div class="flex items-baseline gap-4">
          <span class="display text-[clamp(40px,5vw,64px)] text-brand" aria-hidden="true">30</span>
          <p class="font-head text-[19px] text-white"><b>عيوب التصنيع (خلال 30 يومًا)</b></p>
        </div>
        <p class="mt-5 text-white/85">
          في فود هاكس، نلتزم بتقديم منتجات عالية الجودة. في حال اكتشاف عيب مصنعي في أحد المنتجات،
          يمكنك طلب استبدال المنتج أو استرداد قيمته وفقًا للشروط التالية:
        </p>
        <ul class="mt-4 list-disc space-y-2 ps-6 text-white/85 marker:text-brand">
          <li><b class="text-white">الفترة الزمنية:</b> يجب التواصل معنا خلال 30 يومًا من تاريخ الشراء.</li>
          <li><b class="text-white">السبب:</b> يجب أن يكون الخلل ناتجًا عن عيب في التصنيع.</li>
          <li><b class="text-white">إثبات الشراء:</b> يجب تقديم فاتورة الشراء أو أي إثبات آخر لعملية الشراء.</li>
        </ul>
        <h3 class="mt-6 font-head text-[17px] text-white">كيفية الإبلاغ عن عيب مصنعي</h3>
        <p class="mt-3 text-white/85">
          يرجى التواصل مع فريق خدمة العملاء، مع تزويدنا برقم الطلب أو فاتورة الشراء، ووصف واضح
          للمشكلة. سيقوم فريقنا بمراجعة الحالة وتقييمها، ثم إبلاغك بالإجراءات اللازمة، والتي قد
          تشمل استبدال المنتج أو استرداد قيمته، وفقًا لنتيجة التقييم.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
