---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { routes, t } from '../i18n';

const contactPage = {
  '@type': 'ContactPage',
  '@id': 'https://foodhacks.co/contact-ar/',
  url: 'https://foodhacks.co/contact-ar/',
  name: 'للتواصل - فود هاكز',
  inLanguage: 'ar',
  about: { '@id': 'https://foodhacks.co/#organization' },
};
---

<BaseLayout title="للتواصل - فود هاكز" lang="ar" altHref={routes.contact.en} schema={[contactPage]}>
  <PageHero title="للتواصل" subtitle={t.ar.contactSubtitle} />

  <section class="mx-auto max-w-[1180px] px-4 pb-24 pt-16">
    <div class="grid items-start gap-8 md:grid-cols-[5fr_7fr]">
      <!-- direct-line tile -->
      <div class="on-dark tile mesh-navy reveal relative overflow-hidden p-8 text-white md:p-10">
        <div class="dotgrid pointer-events-none absolute inset-0" aria-hidden="true"></div>
        <div class="relative">
          <p class="sticker rotate-[-2deg] text-lime">{t.ar.directLine}</p>
          <h2 class="display mt-5 text-[clamp(30px,3.4vw,46px)] text-brand">{t.ar.talkToUs}</h2>

          <p class="mt-8">
            <a href="tel:+96522204332" class="inline-flex items-center gap-3 font-head2 text-[18px] text-white transition-colors hover:text-lime">
              <span class="inline-flex h-[42px] w-[42px] flex-none items-center justify-center rounded-full bg-brand text-ink">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.85 21 3 13.15 3 3.5a1 1 0 0 1 1-1H7.5a1 1 0 0 1 1 1c0 1.24.2 2.45.57 3.57a1 1 0 0 1-.24 1.02l-2.21 2.2Z"/></svg>
              </span>
              <span dir="ltr">{t.ar.phoneDisplay}</span>
            </a>
          </p>
          <hr class="my-6 border-white/15" />
          <p>
            <a href="mailto:info@foodhacks.co" class="inline-flex items-center gap-3 font-head2 text-[18px] text-white transition-colors hover:text-lime">
              <span class="inline-flex h-[42px] w-[42px] flex-none items-center justify-center rounded-full bg-brand text-ink">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6L22 7"/></svg>
              </span>
              info@foodhacks.co
            </a>
          </p>
        </div>
      </div>

      <!-- form card -->
      <div class="tile reveal reveal-d1 border-2 border-ink bg-white p-8 shadow-[8px_8px_0_rgba(141,191,68,0.9)] md:p-10">
        <h2 class="font-head text-[22px] text-ink">{t.ar.formIntro}</h2>
        <!--
          TODO: the WP site used Contact Form 7 + reCAPTCHA v3. This static form
          needs a backend: wire `action` to the shared form-relay Worker
          (see DEPLOYMENT.md) before launch — same as the EN form.
        -->
        <form method="post" action="#" class="mt-6 space-y-4">
          <input type="text" name="your-name" placeholder={t.ar.namePlaceholder} required maxlength="400" class="field-line" />
          <input type="email" name="your-email" placeholder={t.ar.emailPlaceholder} required maxlength="400" class="field-line" />
          <input type="tel" name="your-phone" placeholder={t.ar.phonePlaceholder} required maxlength="400" class="field-line" />
          <textarea name="your-message" placeholder={t.ar.messagePlaceholder} rows="6" maxlength="2000" class="field-line"></textarea>
          <button type="submit" class="btn-cta w-full !py-5 !text-[18px]">{t.ar.submitCta}</button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
