---
// BOLD design (promoted 2026-07-12) merged with the EN/AR i18n plumbing:
// lang/dir, hreflang, og:locale, JSON-LD graph (Organization/WebSite) from
// the previous master layout, plus Bold's skip-link, sticky Order-Now CTA,
// scroll-reveal/counter script and the html.js gate.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { dirFor, orderUrl, t, type Lang } from '../i18n';

interface Props {
  title: string;
  description?: string;
  /** Absolute-path OG image, defaults to home banner */
  ogImage?: string;
  ogType?: string;
  /** Extra JSON-LD graph nodes (Product, FAQPage, ...) */
  schema?: Record<string, unknown>[];
  /** Page language — drives lang/dir, og:locale and hreflang direction */
  lang?: Lang;
  /** Path of this page's counterpart in the other language (for hreflang + nav switcher) */
  altHref?: string;
}

const {
  title,
  ogImage = '/images/Banner_20Home_20Page.png',
  ogType = 'website',
  schema = [],
  lang = 'ar',
  altHref,
} = Astro.props;

const description = Astro.props.description ?? t[lang].tagline;

const site = Astro.site ?? new URL('https://foodhacks.co');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImageAbs = new URL(ogImage, site).href;
const altAbs = altHref ? new URL(altHref, site).href : undefined;

// hreflang pairs. Arabic is now the default locale, so x-default points at
// the AR page (flipped from the pre-promotion layout, which pointed at EN).
const hreflangs: { hreflang: string; href: string }[] = [];
if (altAbs) {
  const enHref = lang === 'en' ? canonical : altAbs;
  const arHref = lang === 'ar' ? canonical : altAbs;
  hreflangs.push(
    { hreflang: 'en', href: enHref },
    { hreflang: 'ar', href: arHref },
    { hreflang: 'x-default', href: arHref },
  );
}

const ogLocale = lang === 'ar' ? 'ar_AR' : 'en_US';
const ogLocaleAlt = altAbs ? (lang === 'ar' ? 'en_US' : 'ar_AR') : undefined;

const organization = {
  '@type': 'Organization',
  '@id': `${site.href}#organization`,
  name: 'Food Hacks',
  alternateName: 'فود هاكز',
  url: site.href,
  logo: {
    '@type': 'ImageObject',
    url: new URL('/images/logo.png', site).href,
  },
  sameAs: [
    'https://x.com/FoodHackskw',
    'https://www.instagram.com/foodhacksco',
    'https://www.facebook.com/Foodhackskwt/',
    'https://snapchat.com/t/nXtO2N8V',
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+965-22204332',
    email: 'info@foodhacks.co',
    contactType: 'customer service',
  },
  parentOrganization: { '@type': 'Organization', name: 'San Ramon' },
};

const website = {
  '@type': 'WebSite',
  '@id': `${site.href}#website`,
  url: site.href,
  name: t[lang].siteName,
  publisher: { '@id': `${site.href}#organization` },
  inLanguage: lang === 'ar' ? 'ar' : 'en-US',
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [organization, website, ...schema],
};

const ctaHref = orderUrl[lang];
---

<!doctype html>
<html lang={lang} dir={dirFor(lang)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {hreflangs.map((l) => <link rel="alternate" hreflang={l.hreflang} href={l.href} />)}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:locale" content={ogLocale} />
    {ogLocaleAlt && <meta property="og:locale:alternate" content={ogLocaleAlt} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={t[lang].siteName} />
    <meta property="og:image" content={ogImageAbs} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- flag JS availability so scroll-reveal styles only apply when they can be undone -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="min-h-screen bg-white text-black antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:start-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-5 focus:py-3 focus:text-white"
    >
      {t[lang].skipToContent}
    </a>
    <Header lang={lang} altHref={altHref} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <!-- bold sticky Order Now CTA (external shop, as on the live nav) -->
    <a
      href={ctaHref}
      target="_blank"
      rel="noopener"
      class="btn-cta fixed bottom-5 end-5 z-50 !px-6 !py-3.5 !text-[13px] print:hidden"
      aria-label={t[lang].orderNowAria}
    >
      <span aria-hidden="true" class="inline-block h-2 w-2 rounded-full bg-ink"></span>
      {t[lang].orderNow}
    </a>

    <!-- kinetic scroll reveals + animated counters.
         Tiny inline module: IntersectionObserver only, transform/opacity only,
         fully skipped under prefers-reduced-motion (content stays visible). -->
    <script is:inline>
      (function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var reveals = document.querySelectorAll('.reveal');
        var counters = document.querySelectorAll('[data-count]');

        function finishCounter(el) {
          el.textContent = el.getAttribute('data-count');
        }

        if (reduce || !('IntersectionObserver' in window)) {
          reveals.forEach(function (el) { el.classList.add('is-in'); });
          counters.forEach(finishCounter);
          return;
        }

        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              var el = entry.target;
              el.classList.add('is-in');
              if (el.hasAttribute('data-count')) animateCount(el);
              io.unobserve(el);
            });
          },
          { threshold: 0.12, rootMargin: '12% 0px 0px 0px' }
        );

        function animateCount(el) {
          var target = parseInt(el.getAttribute('data-count'), 10);
          if (isNaN(target)) return finishCounter(el);
          var start = null;
          var dur = 1200;
          function step(ts) {
            if (start === null) start = ts;
            var p = Math.min((ts - start) / dur, 1);
            var eased = 1 - Math.pow(1 - p, 3);
            el.textContent = String(Math.round(target * eased));
            if (p < 1) requestAnimationFrame(step);
          }
          requestAnimationFrame(step);
        }

        reveals.forEach(function (el) { io.observe(el); });
        counters.forEach(function (el) {
          if (!el.classList.contains('reveal')) io.observe(el);
        });
      })();
    </script>
  </body>
</html>
