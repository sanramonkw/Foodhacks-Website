---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../utils/paths';

interface Props {
  product: CollectionEntry<'products'>;
  /** Link the card to the product detail page (true) or the external shop (false) */
  linkToDetail?: boolean;
}
const { product, linkToDetail = true } = Astro.props;
const base = product.data.lang === 'ar' ? '/ar/product/' : '/product/';
const href = linkToDetail ? withBase(`${base}${product.id}/`) : product.data.orderUrl;
---

<!-- Reproduction of the theme's .panel-projects card: green panel, 16px radius,
     5px padding, image on its own 12px radius, title black 17px on the green,
     hover = lighter green (#acd76e) + soft shadow. -->
<a
  href={href}
  target={linkToDetail ? undefined : '_blank'}
  rel={linkToDetail ? undefined : 'noopener'}
  class="block rounded-[16px] bg-brand p-[5px] text-center transition-all duration-[400ms] hover:bg-brand-hover hover:shadow-[0_0_12px_rgba(0,0,0,0.1)]"
>
  <img
    src={withBase(product.data.image)}
    alt={product.data.title}
    width="550"
    height="550"
    loading="lazy"
    class="w-full rounded-[12px] object-contain"
  />
  <h3 class="mx-2 mt-[10px] mb-[20px] min-h-[52px] text-[17px] text-black">
    {product.data.title}
  </h3>
</a>
